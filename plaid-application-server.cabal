cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'plaid-application-server' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               plaid-application-server

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            BSD-3-Clause

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             jinilover

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         columbawong@gmail.com

-- A copyright notice.
-- copyright:
build-type:         Simple
data-dir:           resources

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall -Wredundant-constraints -Wunused-binds -Wunused-imports -Werror

common lang
    default-extensions: DuplicateRecordFields NoFieldSelectors OverloadedRecordDot RecordWildCards OverloadedStrings
    default-language: GHC2021

library lib
    import:           warnings
                    , lang
    exposed-modules:  AppConfig
                    , AppEnv
                    , Bootstrap
                    , Common.Types
                    , Common.Types.ErrorResponseBody
                    , Common.Types.ItemId
                    , Common.Types.PosInt
                    , Common.Types.RequestId
                    , Common.Types.UserId
                    , Common.Utils
                    , Database.Persist.Instances.UUID
                    , DhallConfig
                    , PathPiece.Instances.UUID
                    , Plaid.Client
                    , Plaid.Resource
                    , Plaid.Types
                    , Plaid.Types.AccessToken
                    , Plaid.Types.Account
                    , Plaid.Types.ClientId
                    , Plaid.Types.CreatePublicTokenRequest
                    , Plaid.Types.CreatePublicTokenResponse
                    , Plaid.Types.ErrorResponseBody
                    , Plaid.Types.ExchangeAccessTokenRequest
                    , Plaid.Types.ExchangeAccessTokenResponse
                    , Plaid.Types.InstitutionId
                    , Plaid.Types.ItemId
                    , Plaid.Types.PlaidConfig
                    , Plaid.Types.PlaidEnv
                    , Plaid.Types.PlaidError
                    , Plaid.Types.Product
                    , Plaid.Types.PublicToken
                    , Plaid.Types.RequestId
                    , Plaid.Types.SecretKey
                    , PlaidSecurity.AccessTokenStore
                    , PlaidSecurity.Api
                    , PlaidSecurity.TokenService
                    , PlaidSecurity.Types
                    , PlaidSecurity.Types.AccessToken
                    , PlaidSecurity.Types.ClientId
                    , PlaidSecurity.Types.PlaidSecurityConfig
                    , PlaidSecurity.Types.PublicToken
                    , PlaidSecurity.Types.SecretKey
                    , PlaidSecurity.Types.TokenExchangeResponse
                    , PlaidSecurity.Types.TokenServiceError
                    , Server
                    , Store.Migration
                    , Store.Resource
                    , Store.Types
                    , Store.Types.StoreConfig
                    , Store.Types.EssentialColumns
                    , Store.Types.StoreEnv
                    , Store.Utils
    autogen-modules:  Paths_plaid_application_server
    other-modules:    Paths_plaid_application_server
    hs-source-dirs:   src/lib
    build-depends:    base
                    , aeson
                    , bytestring
                    , dhall
                    , exceptions
                    , http-client-tls
                    , http-types
                    , katip
                    , lens
                    , monad-logger
                    , mtl
                    , network-uri
                    , path-pieces
                    , persistent
                    , persistent-postgresql
                    , refined
                    , resource-pool
                    , servant-client
                    , servant-server
                    , string-conv
                    , text
                    , time
                    , uuid
                    , validation
                    , warp

executable plaid-application-server
    import:           warnings
                    , lang

    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:    base
                    , lib

    -- Directories containing source files.
    hs-source-dirs:   src/app

    -- Base language which the package is written in.
    default-language: GHC2021
